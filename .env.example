# Configuration SMTP du formulaire de contact.
#
# Copier ce fichier en .env, le remplir, et le déposer sur le serveur dans
#     /home/les2ailes/.env
# c'est-à-dire UN NIVEAU AU-DESSUS de public_html, donc hors du dossier web.
#
# Le .env n'est jamais commité : le dépôt GitHub est public.

SMTP_HOST=mail.exemple.com
SMTP_PORT=587
SMTP_USER=noreply@exemple.com
SMTP_PASS=motdepasse
SMTP_SECURE=tls

# Expéditeur technique des messages
MAIL_FROM=noreply@exemple.com
MAIL_FROM_NAME=Site Les2L

# Destinataire des demandes du formulaire
MAIL_TO=destinataire@exemple.com
MAIL_TO_NAME=Les2L
